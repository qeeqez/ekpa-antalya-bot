{
  "family": "ekpa-antalya-bot",
  "containerDefinitions": [
    {
      "name": "ekpa-antalya-bot",
      "cpu": 256,
      "memory": 400,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "qeeqez-ecs",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ekpa-antalya-bot"
        }
      }
    }
  ]
}
